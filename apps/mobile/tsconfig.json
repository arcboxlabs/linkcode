{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "${configDir}/node_modules/.cache/tsconfig.tsbuildinfo",
    "paths": {
      "@mobile/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "strict": true
  },
  "include": ["src", "modules", "scripts", "app.config.ts", "vitest.config.ts"]
}
